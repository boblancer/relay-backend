# Persistence API
# Required by the FastAPI persistence service.
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
BASIC_AUTH_USERNAME=relay
BASIC_AUTH_PASSWORD=change-me

# Browserbase execution
# Required only for real Browserbase runs.
BROWSERBASE_API_KEY=

# Automation run service defaults to 127.0.0.1:8080 and requires no service token.
# Terminal screenshots default to enabled and persist under .relay/artifacts/.
# Set AUTOMATION_SCREENSHOTS=false to disable capture and artifact serving.
