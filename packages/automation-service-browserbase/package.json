{
  "name": "@relay/automation-service-browserbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "relay-browserbase-service": "./dist/main.js"
  },
  "files": [
    "dist",
    "openapi.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:browserbase": "BROWSERBASE_E2E=1 vitest run tests/browserbase.smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@relay/automation-worker-browserbase": "file:../automation-worker-browserbase",
    "fastify": "^5.11.0",
    "inngest": "^4.15.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
